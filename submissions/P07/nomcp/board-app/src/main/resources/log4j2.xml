<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
    <Appenders>
        <Console name="console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss.SSS} %5p [%t] %c{1.} - %m%n"/>
        </Console>
    </Appenders>
    <Loggers>
        <Logger name="egovframework" level="INFO" additivity="false">
            <AppenderRef ref="console"/>
        </Logger>
        <Logger name="org.egovframe" level="INFO" additivity="false">
            <AppenderRef ref="console"/>
        </Logger>
        <Logger name="org.springframework" level="INFO" additivity="false">
            <AppenderRef ref="console"/>
        </Logger>
        <!-- EgovAbstractMapper(DaoSupport)의 final 메서드에 대한 CGLIB 프록시 경고 -->
        <Logger name="org.springframework.aop.framework.CglibAopProxy" level="ERROR" additivity="false">
            <AppenderRef ref="console"/>
        </Logger>
        <Root level="WARN">
            <AppenderRef ref="console"/>
        </Root>
    </Loggers>
</Configuration>
