<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="BoardMapper">

    <resultMap id="boardResultMap" type="egov.board.service.vo.BoardVO">
        <id     property="boardId"   column="BOARD_ID"/>
        <result property="title"     column="TITLE"/>
        <result property="content"   column="CONTENT"/>
        <result property="writer"    column="WRITER"/>
        <result property="viewCnt"   column="VIEW_CNT"/>
        <result property="regDt"     column="REG_DT"/>
        <result property="modDt"     column="MOD_DT"/>
        <result property="atcFileNo" column="ATC_FILE_NO"/>
    </resultMap>

    <sql id="boardColumn">
        B.BOARD_ID,
        B.TITLE,
        B.CONTENT,
        B.WRITER,
        B.VIEW_CNT,
        B.REG_DT,
        B.MOD_DT
    </sql>

    <!-- 검색 조건. searchCond 는 BoardSearchVO.normalizeSearchCond() 로 허용 값만 남긴다. -->
    <sql id="searchCondition">
        <where>
            <if test="hasSearchWord">
                <choose>
                    <when test='searchCond == "TITLE"'>
                        AND UPPER(B.TITLE) LIKE '%' || UPPER(#{searchWord}) || '%'
                    </when>
                    <when test='searchCond == "CONTENT"'>
                        AND UPPER(B.CONTENT) LIKE '%' || UPPER(#{searchWord}) || '%'
                    </when>
                    <when test='searchCond == "WRITER"'>
                        AND UPPER(B.WRITER) LIKE '%' || UPPER(#{searchWord}) || '%'
                    </when>
                    <when test='searchCond == "TITLE_CONTENT"'>
                        AND (UPPER(B.TITLE) LIKE '%' || UPPER(#{searchWord}) || '%'
                            OR UPPER(B.CONTENT) LIKE '%' || UPPER(#{searchWord}) || '%')
                    </when>
                </choose>
            </if>
        </where>
    </sql>

    <!-- 목록 건수 -->
    <select id="countBoardList" parameterType="egov.board.service.vo.BoardSearchVO" resultType="int">
        SELECT COUNT(*)
          FROM BOARD B
        <include refid="searchCondition"/>
    </select>

    <!--
        게시물 목록 (검색 + 페이징)
        페이징 값(${recordCountPerPage}, ${firstRecordIndex}) 은 표준프레임워크 PaginationInfo 가
        계산한 int 값만 들어오므로 문자열 치환을 사용한다.
    -->
    <select id="selectBoardList" parameterType="egov.board.service.vo.BoardSearchVO" resultMap="boardResultMap">
        SELECT
        <include refid="boardColumn"/>
             , (SELECT COUNT(*) FROM ATC_FILE F WHERE F.BOARD_ID = B.BOARD_ID) AS ATC_FILE_NO
          FROM BOARD B
        <include refid="searchCondition"/>
        ORDER BY B.REG_DT DESC, B.BOARD_ID DESC
        LIMIT ${recordCountPerPage} OFFSET ${firstRecordIndex}
    </select>

    <!-- 게시물 상세 -->
    <select id="selectBoard" parameterType="egov.board.service.vo.BoardVO" resultMap="boardResultMap">
        SELECT
        <include refid="boardColumn"/>
             , (SELECT COUNT(*) FROM ATC_FILE F WHERE F.BOARD_ID = B.BOARD_ID) AS ATC_FILE_NO
          FROM BOARD B
         WHERE B.BOARD_ID = #{boardId}
    </select>

    <!-- 게시물 등록 -->
    <insert id="insertBoard" parameterType="egov.board.service.vo.BoardVO">
        INSERT INTO BOARD (BOARD_ID, TITLE, CONTENT, WRITER, VIEW_CNT, REG_DT, MOD_DT)
        VALUES (#{boardId}, #{title}, #{content}, #{writer}, 0, CURRENT_TIMESTAMP, NULL)
    </insert>

    <!-- 게시물 수정 -->
    <update id="updateBoard" parameterType="egov.board.service.vo.BoardVO">
        UPDATE BOARD
           SET TITLE    = #{title},
               CONTENT  = #{content},
               MOD_DT   = CURRENT_TIMESTAMP
         WHERE BOARD_ID = #{boardId}
    </update>

    <!-- 게시물 삭제 -->
    <delete id="deleteBoard" parameterType="egov.board.service.vo.BoardVO">
        DELETE FROM BOARD
         WHERE BOARD_ID = #{boardId}
    </delete>

    <!-- 조회수 증가 -->
    <update id="updateBoardViewCnt" parameterType="egov.board.service.vo.BoardVO">
        UPDATE BOARD
           SET VIEW_CNT = VIEW_CNT + 1
         WHERE BOARD_ID = #{boardId}
    </update>

</mapper>
